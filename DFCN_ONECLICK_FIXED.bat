@echo off
setlocal
title DFCN Auto Installer
echo.
echo ==========================================
echo   DFCN Auto Install + Launch
echo ==========================================
echo.
powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -EncodedCommand 
set "ERR=%ERRORLEVEL%"
if not "%ERR%"=="0" (
  echo.
  echo [ERROR] Installer failed. Code: %ERR%
  echo.
  pause
  exit /b %ERR%
)
echo.
echo Done.
timeout /t 2 /nobreak >nul
endlocal
